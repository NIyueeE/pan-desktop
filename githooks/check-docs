#!/usr/bin/env bash
# Docs-alignment check: verify the modular docs (docs/ + README landing pages)
# still describe the actual code (hook gates, lints, toolchain, edition,
# justfile, CI).
# Covers greppable invariants only; semantic alignment stays with the agent/human.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

errors=0

expect() {
  # expect <description> <file> <fixed-string-pattern>
  local desc="$1" file="$2" pattern="$3"
  if grep -qF -- "$pattern" "$file"; then
    echo "  ok    $desc"
  else
    echo "  FAIL  $desc -> missing '$pattern' in $file" >&2
    errors=$((errors + 1))
  fi
}

# 1) every gate echoed in a hook must be documented in the checks docs
for hook in githooks/pre-commit githooks/pre-push; do
  while IFS= read -r label; do
    [ -n "$label" ] || continue
    expect "[$hook] gate documented: $label" docs/checks.md "$label"
    expect "[$hook] gate documented: $label" docs/checks.zh.md "$label"
  done < <(grep -E '^echo "==>' "$hook" | sed 's/^echo "==>[[:space:]]*//; s/"$//')
done

# 2) every lint declared in src-tauri/Cargo.toml [lints] must be documented
#    in the lint-policy docs
while IFS= read -r lint; do
  [ -n "$lint" ] || continue
  expect "lint documented: $lint" docs/lint-policy.md '`'"$lint"'`'
  expect "lint documented: $lint" docs/lint-policy.zh.md '`'"$lint"'`'
done < <(awk '/^\[lints\./{f=1;next} /^\[/{f=0} f && /=/{split($0,a,"="); k=a[1]; gsub(/[ \t]/,"",k); if (k != "") print k}' src-tauri/Cargo.toml)

# 3) rustc edition
expect "edition documented: 2024" README.md "2024 edition"
expect "edition documented: 2024" README.zh.md "2024 Edition"

# 4) toolchain channel
expect "toolchain channel documented" README.md 'channel = "stable"'
expect "toolchain channel documented" README.zh.md 'channel = "stable"'

# 5) justfile recipes documented on the landing pages
expect "just setup documented" README.md 'just setup'
expect "just setup documented" README.zh.md 'just setup'
expect "just check documented" README.md 'just check'
expect "just check documented" README.zh.md 'just check'

# 6) hooks activation instruction
expect "hooksPath instruction documented" README.md 'core.hooksPath githooks'
expect "hooksPath instruction documented" README.zh.md 'core.hooksPath githooks'

# 7) docs gate itself must stay documented in the checks docs
expect "docs gate documented" docs/checks.md 'githooks/check-docs'
expect "docs gate documented" docs/checks.zh.md 'githooks/check-docs'

# 8) READMEs must link the modular docs (index integrity, per language)
for doc in checks lint-policy release structure usage windows-troubleshooting; do
  expect "README links docs/$doc.md" README.md "docs/$doc.md"
  expect "README links docs/$doc.zh.md" README.zh.md "docs/$doc.zh.md"
done

# 9) CI must run the same chain and extract release notes from CHANGELOG
if [ -f .github/workflows/package.yml ]; then
  expect "CI checks formatting" .github/workflows/package.yml 'bun run format'
  expect "CI runs strict lint" .github/workflows/package.yml 'bun run lint'
  expect "CI typechecks the frontend" .github/workflows/package.yml 'bun run typecheck'
  expect "CI runs the frontend tests" .github/workflows/package.yml 'bun run test:ui'
  expect "release notes extracted from CHANGELOG" .github/workflows/package.yml 'CHANGELOG'
else
  echo "  FAIL  .github/workflows/package.yml missing" >&2
  errors=$((errors + 1))
fi

# 10) secret scan gate wired into the chain and documented
if [ -f githooks/check-secrets ]; then
  expect "secret scan gate wired" githooks/pre-commit 'githooks/check-secrets'
  expect "secret scan documented" docs/checks.md 'githooks/check-secrets'
  expect "secret scan documented" docs/checks.zh.md 'githooks/check-secrets'
else
  echo "  FAIL  githooks/check-secrets missing (secrets discipline)" >&2
  errors=$((errors + 1))
fi

# 11) docs pages come in bilingual pairs (top level of docs/)
for doc in docs/*.md; do
  case "$doc" in *.zh.md) continue ;; esac
  if [ ! -f "${doc%.md}.zh.md" ]; then
    echo "  FAIL  missing zh counterpart: $doc" >&2
    errors=$((errors + 1))
  fi
 done

# 12) HANDOFF.md: agent-facing state notes exist and are referenced
if [ -f HANDOFF.md ]; then
  expect "README links HANDOFF.md" README.md 'HANDOFF.md'
  expect "README links HANDOFF.md" README.zh.md 'HANDOFF.md'
  expect "AGENTS.md references HANDOFF.md" AGENTS.md 'HANDOFF.md'
else
  echo "  FAIL  HANDOFF.md missing (AGENTS.md points to it for working state)" >&2
  errors=$((errors + 1))
fi

if [ "$errors" -eq 0 ]; then
  echo "  docs alignment ok"
else
  echo "  $errors docs alignment issue(s) found" >&2
  exit 1
fi
