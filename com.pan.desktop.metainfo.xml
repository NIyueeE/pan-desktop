    <name>Pan</name>
    <summary>A translation and OCR app powered by OpenAI-compatible APIs</summary>
    <summary xml:lang="zh-Hans">一款基于 OpenAI 兼容接口的划词翻译和 OCR 翻译软件</summary>
    <developer id="com.pan">
        <name>pan-desktop</name>
