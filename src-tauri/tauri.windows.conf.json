{
    "app": {
        "windows": [
            {
                "title": "Daemon",
                "label": "daemon",
                "visible": false,
                "url": "daemon.html",
                "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-web-security",
                "useHttpsScheme": false
            }
        ]
    },
    "bundle": {
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": "",
            "webviewInstallMode": {
                "silent": true,
                "type": "embedBootstrapper"
            },
            "nsis": {
                "displayLanguageSelector": true,
                "installerIcon": "icons/icon.ico",
                "installMode": "perMachine",
                "languages": ["SimpChinese", "TradChinese", "English"]
            }
        }
    }
}
