{
    "name": "pan",
    "private": true,
    "version": "4.1.3",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "lint": "eslint src --max-warnings=0 && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "lint:js": "eslint src --max-warnings=0",
        "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "lint:fix": "eslint src --fix && cargo clippy --manifest-path src-tauri/Cargo.toml --fix --allow-dirty --allow-staged --all-targets -- -D warnings",
        "format": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
        "format:fix": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
        "check": "pnpm format && pnpm lint && pnpm test && vite build && cargo check --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
        "test:webdav": "node scripts/test-webdav.mjs",
        "test:ui": "vitest run",
        "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
        "test": "pnpm test:webdav && pnpm test:ui && pnpm test:rs"
    },
    "dependencies": {
        "@nextui-org/react": "^2.4.8",
        "@nextui-org/theme": "^2.2.11",
        "@react-spring/web": "^9.7.5",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-autostart": "^2.5.1",
        "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
        "@tauri-apps/plugin-fs": "^2.5.1",
        "@tauri-apps/plugin-global-shortcut": "^2.3.2",
        "@tauri-apps/plugin-http": "^2.5.9",
        "@tauri-apps/plugin-log": "^2.9.0",
        "@tauri-apps/plugin-notification": "^2.3.3",
        "@tauri-apps/plugin-os": "^2.3.2",
        "@tauri-apps/plugin-shell": "^2.3.5",
        "@tauri-apps/plugin-store": "^2.4.4",
        "flag-icons": "^7.2.3",
        "framer-motion": "^11.11.10",
        "i18next": "^23.16.4",
        "jose": "^5.9.6",
        "jotai": "^2.10.1",
        "nanoid": "^5.0.8",
        "next-themes": "^0.3.0",
        "react": "^18.3.1",
        "react-beautiful-dnd": "^13.1.1",
        "react-dom": "^18.3.1",
        "react-hot-toast": "^2.4.1",
        "react-i18next": "^15.1.0",
        "react-icons": "^5.3.0",
        "react-router-dom": "^6.27.0",
        "react-spinners": "^0.14.1",
        "react-use-measure": "^2.1.1",
        "tesseract.js": "^5.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.4.20",
        "eslint": "^10.8.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "jsdom": "^30.0.1",
        "postcss": "^8.4.47",
        "prettier": "3.3.2",
        "tailwindcss": "^3.4.14",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^5.4.10",
        "vitest": "^2.1.9"
    }
}
