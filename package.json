{
    "name": "pan",
    "private": true,
    "version": "4.3.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "lint": "bun run lint:js && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "lint:js": "eslint . --max-warnings=0",
        "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "format": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
        "format:fix": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
        "typecheck": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
        "test:webdav": "bun scripts/test-webdav.ts",
        "test:ui": "vitest run",
        "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
        "test": "bun run test:webdav && bun run test:ui && bun run test:rs",
        "check": "bun run format && bun run lint && bun run typecheck && bun run test && bun run build && cargo check --manifest-path src-tauri/Cargo.toml"
    },
    "dependencies": {
        "@lucide/svelte": "^1.59.0",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-autostart": "^2.7.0",
        "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@tauri-apps/plugin-global-shortcut": "^2.4.1",
        "@tauri-apps/plugin-http": "^2.8.3",
        "@tauri-apps/plugin-log": "^2.10.1",
        "@tauri-apps/plugin-notification": "^2.7.0",
        "@tauri-apps/plugin-os": "^2.4.0",
        "@tauri-apps/plugin-shell": "^2.5.0",
        "@tauri-apps/plugin-store": "^2.5.0",
        "bits-ui": "^2.19.5",
        "i18next": "^26.5.2",
        "svelte-sonner": "^1.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.12.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
